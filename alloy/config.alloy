logging {
  level = "info"
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
  external_labels = {job = "soc-monitor"}
}

local.file_match "app_logs" {
  path_targets = [{__path__ = "/app/soc_monitor.log"}]
}

loki.source.file "app_log_source" {
  targets = local.file_match.app_logs.targets
  forward_to = [loki.write.default.receiver]
}
